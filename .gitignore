*.zip
src/assets/model/

# TecPonto project workspace - local/private areas
/_workspace/
/_private/
/_cloud/

# Physical store records (local/cloud only)
/store/fotos/
/store/medidas/
/store/orcamentos/

# Business records (local/cloud only)
/business/custos/
/business/fornecedores/
/business/documentos/

# Operational records (local/cloud only)
/operations/clientes/
/operations/caixa/
/operations/ordens-de-servico/

