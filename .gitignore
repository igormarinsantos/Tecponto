# Credentials and environment files
.env
.env.local
.env.production
.env.*
!.env.example

# Internal documents and data exports
*.xlsx
*.xls
*.csv
*.docx
*.heic
*.pdf

# Raw images are ignored globally, except website assets below
*.jpg
*.jpeg
*.png
*.webp

# Sensitive filenames
**/*senha*
**/*password*
**/*token*
**/*secret*
**/*chave*
**/*cliente*
**/*fornecedor*
**/*orcamento*
**/*orçamento*
**/*contrato*

# Keep all website source and public assets eligible for version control
!/src/**
!/public/**
!/brand/logos/**

# Model source files remain intentionally local
/src/assets/model/

# Build outputs and local-only helpers
/node_modules/
/.next/
/dist/
/build/
/dev-local.mjs
